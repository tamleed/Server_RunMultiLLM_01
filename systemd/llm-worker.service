[Unit]
Description=LLM Switchboard Worker
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/llm-switchboard
EnvironmentFile=/etc/llm-gateway.env
ExecStart=/opt/llm-switchboard/.venv/bin/python -m worker.worker
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
